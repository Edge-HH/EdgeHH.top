---
import Icon from './Icon.astro';
import { formatDate, isoDate, type Post } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, tags, draft } = post.data;
---

<li class="post-row" data-tags={tags.join('|')}>
  <a href={`/posts/${post.id}/`}>
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    <span class="main">
      <span class="title">
        {title}
        {draft && <span class="chip">草稿</span>}
      </span>
      {description && <span class="desc">{description}</span>}
    </span>
    <Icon name="chevron" size={18} class="chev" />
  </a>
</li>

<style>
  .post-row {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .post-row[hidden] {
    display: none;
  }

  a {
    display: grid;
    grid-template-columns: 9.5em 1fr auto;
    align-items: baseline;
    gap: 8px 24px;
    padding: 22px 4px;
    transition: background-color 0.25s;
  }

  time {
    color: var(--fg-2);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .main {
    display: grid;
    gap: 4px;
  }

  .title {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.4;
  }

  .desc {
    color: var(--fg-2);
    font-size: 15px;
  }

  a :global(.chev) {
    align-self: center;
    color: var(--fg-3);
    transition:
      translate 0.35s var(--ease),
      color 0.25s;
  }

  a:hover .title {
    color: var(--link);
  }

  a:hover :global(.chev) {
    translate: 4px 0;
    color: var(--link);
  }

  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr auto;
    }

    time {
      grid-column: 1 / -1;
      font-size: 14px;
    }
  }
</style>
