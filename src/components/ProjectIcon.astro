---
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  size?: number;
}

const { project, size = 48 } = Astro.props;
const { name, icon, iconStyle, accent } = project.data;
---

<span class:list={['project-icon', `is-${icon ? iconStyle : 'letter'}`]} style={`--size:${size}px;--accent:${accent}`}>
  {
    icon?.format === 'svg' ? (
      <img src={icon.src} alt="" width={size} height={size} />
    ) : icon ? (
      <Image src={icon} alt="" width={size} height={size} densities={[1, 2]} />
    ) : (
      <span aria-hidden="true">{name.slice(0, 1)}</span>
    )
  }
</span>

<style>
  .project-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 22%;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--frame);
  }

  .project-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .is-tile {
    background: #ffffff;
  }

  .is-tile img {
    width: 78%;
    height: 78%;
  }

  /* 没有图标的项目：项目色底 + 首字母 */
  .is-letter {
    background: var(--accent);
    color: #1c1300;
    font-size: calc(var(--size) * 0.5);
    font-weight: 700;
    line-height: 1;
  }
</style>
