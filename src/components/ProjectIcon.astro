---
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  size?: number;
  class?: string;
}

const { project, size = 64, class: className } = Astro.props;
const { name, icon, iconStyle, accent } = project.data;
---

<span
  class:list={['project-icon', `is-${icon ? iconStyle : 'mono'}`, className]}
  style={`--size:${size}px;--accent:${accent}`}
>
  {
    icon?.format === 'svg' ? (
      <img src={icon.src} alt="" width={size} height={size} />
    ) : icon ? (
      <Image src={icon} alt="" width={size} height={size} densities={[1, 2]} loading="eager" />
    ) : (
      <span aria-hidden="true">{name.slice(0, 1)}</span>
    )
  }
</span>

<style>
  .project-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 23%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--line),
      0 6px 18px -6px rgb(0 0 0 / 0.3);
  }

  .project-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .is-tile {
    background: #ffffff;
  }

  .is-tile img {
    width: 80%;
    height: 80%;
  }

  .is-mono {
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.45), transparent 55%),
      linear-gradient(145deg, var(--accent), color-mix(in srgb, var(--accent) 70%, #000000));
    color: #ffffff;
    font-size: calc(var(--size) * 0.5);
    font-weight: 700;
    line-height: 1;
  }
</style>
