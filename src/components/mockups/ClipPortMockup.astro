---
import { Image } from 'astro:assets';
import MockFrame from '../MockFrame.astro';
import Icon from '../Icon.astro';
import appIcon from '../../assets/projects/clipport/icon.png';

// 每项数据对应滚动的三个阶段：复制中 / 校验中 / 完成；没有滚动阶段时显示第二项
const stage = ['正在复制', '正在校验', '任务完成'];
const percent = ['42.7%', '68.4%', '100%'];
const stats = [
  { label: '文件', values: ['742 / 1,876', '1,284 / 1,876', '1,876 / 1,876'] },
  { label: '数据量', values: ['116.3 / 272.0 GB', '186.2 / 272.0 GB', '272.0 GB'] },
  { label: '速度', values: ['812 MB/s', '1.24 GB/s', '平均 905 MB/s'] },
  { label: '校验算法', values: ['SHA-256'] }
];
const rows = [
  { name: 'C0001.MP4', size: '9.8 GB', hash: ['—', '9f2c41d7…e81a', '9f2c41d7…e81a'], status: ['已复制', '一致', '一致'] },
  { name: 'C0002.MP4', size: '7.1 GB', hash: ['—', '3b7d90aa…0c4f', '3b7d90aa…0c4f'], status: ['已复制', '一致', '一致'] },
  { name: 'C0003.MP4', size: '12.4 GB', hash: ['—', '计算中…', 'a41e5c02…77b9'], status: ['复制中', '校验中', '一致'] },
  { name: 'C0004.MP4', size: '6.2 GB', hash: ['—', '—', '5e09b3f1…c3d1'], status: ['等待', '等待', '一致'] },
  { name: 'C0005.MP4', size: '8.9 GB', hash: ['—', '—', 'c7a2e690…41fe'], status: ['等待', '等待', '一致'] }
];
const statusClass: Record<string, string> = { 一致: 'ok', 复制中: 'busy', 校验中: 'busy' };

const variants = (values: string[]) => values.map((value, i) => ({ value, s: i === 1 ? '1 d' : String(i) }));

/** 生成首尾相接的波形，宽度为两个周期，向左平移一个周期即可无缝循环 */
function wave(seed: number, base: number, amp: number) {
  const step = 16;
  const ys = Array.from({ length: 20 }, (_, i) => {
    const v = Math.sin(i * 0.9 + seed) * 0.55 + Math.sin(i * 2.3 + seed * 3) * 0.3 + Math.sin(i * 5.1 + seed) * 0.15;
    return Math.round((base - v * amp) * 10) / 10;
  });
  const points = [...ys, ...ys, ys[0]].map((y, i) => `${i * step} ${y}`);
  const line = `M${points.join(' L')}`;
  return { line, area: `${line} L640 100 L0 100 Z` };
}

const charts = [
  { key: 'copy', title: '复制速度', value: '812 MB/s', ...wave(1, 46, 22) },
  { key: 'verify', title: '校验速度', value: '1.24 GB/s', ...wave(4, 38, 20) }
];
---

<MockFrame width={1000} height={640} label="ClipPort：拷卡任务界面，显示复制与校验进度、吞吐波形和逐文件 SHA-256 校验结果">
  <div class="cp">
    <div class="win">
      <div class="titlebar">
        <Image src={appIcon} alt="" width={18} height={18} densities={[2]} />
        <span>ClipPort</span>
        <span class="controls">
          <svg viewBox="0 0 10 10"><path d="M1 5h8"></path></svg>
          <svg viewBox="0 0 10 10"><rect x="1" y="1" width="8" height="8" rx="1"></rect></svg>
          <svg viewBox="0 0 10 10"><path d="m1 1 8 8M9 1 1 9"></path></svg>
        </span>
      </div>

      <div class="body">
        <aside class="side">
          <div class="actions">
            <span class="create">+ 创建任务</span>
            <span class="ghost">多选</span>
          </div>
          <p class="group">新任务</p>
          <div class="task active">
            <b>A 卡 · 外景素材</b>
            <small>272.0 GB · 进行中</small>
            <span class="mini"><i></i></span>
          </div>
          <p class="group">历史任务</p>
          <div class="task">
            <b>婚礼素材 B 卡</b>
            <small>1.61 TB · 10/12 21:42</small>
            <span class="done"><Icon name="shield" size={13} /> 任务完成</span>
          </div>
          <div class="task">
            <b>waveform-source</b>
            <small>5.96 GB · 10/08 20:25</small>
            <span class="done"><Icon name="shield" size={13} /> 任务完成</span>
          </div>
        </aside>

        <div class="main">
          <div class="head">
            <div>
              <h4>A 卡 · 外景素材</h4>
              <code>D:\DCIM\100MSDCF → E:\Projects\2026-10-17</code>
            </div>
            <div class="pct">
              <span class="vs stage">{variants(stage).map((v) => <span class="v" data-s={v.s}>{v.value}</span>)}</span>
              <span class="vs num">{variants(percent).map((v) => <span class="v" data-s={v.s}>{v.value}</span>)}</span>
            </div>
          </div>

          <div class="progress"><i></i></div>

          <div class="stats">
            {
              stats.map((stat) => (
                <div class="stat">
                  <small>{stat.label}</small>
                  {stat.values.length === 1 ? (
                    <b>{stat.values[0]}</b>
                  ) : (
                    <b class="vs">
                      {variants(stat.values).map((v) => (
                        <span class="v" data-s={v.s}>
                          {v.value}
                        </span>
                      ))}
                    </b>
                  )}
                </div>
              ))
            }
          </div>

          <div class="charts">
            {
              charts.map((chart) => (
                <div class:list={['chart', chart.key]}>
                  <div class="chart-head">
                    <span>{chart.title}</span>
                    <b>{chart.value}</b>
                  </div>
                  <svg viewBox="0 0 320 100" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id={`cp-fill-${chart.key}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="currentColor" stop-opacity="0.35" />
                        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    <path class="grid" d="M0 25H320M0 50H320M0 75H320" />
                    <g class="flow">
                      <path d={chart.area} fill={`url(#cp-fill-${chart.key})`} />
                      <path class="line" d={chart.line} />
                    </g>
                  </svg>
                </div>
              ))
            }
          </div>

          <div class="files">
            <div class="frow fhead">
              <span>文件</span><span>大小</span><span>SHA-256</span><span>状态</span>
            </div>
            {
              rows.map((row) => (
                <div class="frow">
                  <span>{row.name}</span>
                  <span>{row.size}</span>
                  <span class="vs">
                    {variants(row.hash).map((v) => (
                      <span class="v" data-s={v.s}>
                        {v.value}
                      </span>
                    ))}
                  </span>
                  <span class="vs">
                    {variants(row.status).map((v) => (
                      <span class:list={['v', 'status', statusClass[v.value]]} data-s={v.s}>
                        {v.value}
                      </span>
                    ))}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="toast">
        <span class="toast-icon"><Icon name="shield" size={18} /></span>
        <div>
          <b>任务完成</b>
          <p>1,876 个文件全部一致 · 已推送到飞书与 Bark</p>
        </div>
      </div>
    </div>
  </div>
</MockFrame>

<style>
  .cp {
    --teal: #2de2c8;
    --prog: 68.4%;
    position: relative;
    width: 1000px;
    height: 640px;
    font-family: var(--font-sans);
    color: #e8e8e8;
    font-size: 13px;
    line-height: 1.4;
  }

  .win {
    position: absolute;
    inset: 10px 0;
    border-radius: 12px;
    background: #202020;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09),
      0 50px 90px -40px rgb(0 0 0 / 0.7),
      0 12px 30px -12px rgb(0 0 0 / 0.35);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding-left: 16px;
    color: #cfcfcf;
    font-size: 12px;
  }

  .titlebar img {
    border-radius: 4px;
  }

  .controls {
    display: flex;
    margin-left: auto;
  }

  .controls svg {
    width: 46px;
    height: 10px;
    fill: none;
    stroke: #bdbdbd;
    stroke-width: 1;
  }

  .body {
    display: grid;
    grid-template-columns: 248px 1fr;
    height: 580px;
  }

  /* ---- 左侧任务列表 ---- */
  .side {
    padding: 8px 16px 16px;
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  .actions span {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 600;
  }

  .create {
    background: #0f766a;
    color: #e9fffb;
  }

  .ghost {
    background: #2b2b2b;
    color: #d4d4d4;
  }

  .group {
    margin: 18px 0 8px;
    color: #9a9a9a;
    font-size: 11.5px;
  }

  .task {
    position: relative;
    display: grid;
    gap: 3px;
    padding: 12px 14px;
    margin-bottom: 8px;
    border-radius: 9px;
    background: #2b2b2b;
  }

  .task b {
    font-size: 13px;
    font-weight: 600;
  }

  .task small {
    color: #9a9a9a;
    font-size: 11px;
  }

  .task.active {
    background: #2f3332;
    box-shadow: inset 3px 0 0 var(--teal);
  }

  .mini {
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background: #444444;
    overflow: hidden;
  }

  .mini i {
    display: block;
    width: var(--prog);
    height: 100%;
    background: var(--teal);
    transition: width 0.9s var(--ease);
  }

  .done {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    color: #cfcfcf;
    font-size: 11.5px;
  }

  .done :global(svg) {
    color: var(--teal);
  }

  /* ---- 主区域 ---- */
  .main {
    padding: 14px 24px 20px 8px;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .head h4 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .head code {
    color: #8a8a8a;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .pct {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .stage {
    color: #a8a8a8;
    font-size: 13px;
    justify-items: end;
  }

  .num {
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    justify-items: end;
  }

  .progress {
    height: 6px;
    margin: 14px 0 16px;
    border-radius: 3px;
    background: #333333;
    overflow: hidden;
  }

  .progress i {
    position: relative;
    display: block;
    width: var(--prog);
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, #0f9d8a, var(--teal));
    overflow: hidden;
    transition: width 0.9s var(--ease);
  }

  .progress i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.55), transparent);
    translate: -100% 0;
    animation: cp-shine 2.2s ease-in-out infinite;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .stat {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #282828;
  }

  .stat small {
    color: #8f8f8f;
    font-size: 11px;
  }

  .stat b {
    font-size: 16px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 12px 0;
  }

  .chart {
    padding: 12px 14px;
    border-radius: 10px;
    background: #282828;
    color: var(--teal);
    transition: opacity 0.5s;
  }

  .chart.verify {
    color: #7dd3fc;
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 12px;
  }

  .chart-head span {
    color: #a8a8a8;
  }

  .chart svg {
    width: 100%;
    height: 112px;
    overflow: hidden;
  }

  .grid {
    stroke: #3a3a3a;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }

  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .flow {
    animation: cp-flow 7s linear infinite;
  }

  .verify .flow {
    animation-duration: 5.5s;
  }

  .files {
    border-radius: 10px;
    background: #282828;
    overflow: hidden;
  }

  .frow {
    display: grid;
    grid-template-columns: 1.1fr 0.7fr 1.4fr 0.8fr;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-top: 1px solid #323232;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .fhead {
    height: 30px;
    border-top: 0;
    color: #8f8f8f;
    font-family: var(--font-sans);
    font-size: 11px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #9a9a9a;
    font-family: var(--font-sans);
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status.ok {
    color: var(--teal);
  }

  .status.busy {
    color: #ffc76b;
  }

  .status.busy::before {
    animation: cp-blink 1s ease-in-out infinite;
  }

  .toast {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background: #2c2c2c;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 20px 40px -10px rgb(0 0 0 / 0.6);
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.5s var(--ease),
      translate 0.7s var(--ease);
  }

  .toast-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(45 226 200 / 0.16);
    color: var(--teal);
  }

  .toast b {
    font-size: 13.5px;
  }

  .toast p {
    color: #a8a8a8;
    font-size: 11.5px;
  }

  /* ---- 多阶段文字：叠放在同一格，按阶段淡入 ---- */
  .vs {
    display: inline-grid;
  }

  .v {
    grid-area: 1 / 1;
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.45s var(--ease);
  }

  .v[data-s~='d'] {
    opacity: 1;
  }

  :global([data-step]) .v[data-s~='d'] {
    opacity: 0;
  }

  :global([data-step='0']) .v[data-s~='0'],
  :global([data-step='1']) .v[data-s~='1'],
  :global([data-step='2']) .v[data-s~='2'] {
    opacity: 1;
  }

  :global([data-step='0']) .cp {
    --prog: 42.7%;
  }

  :global([data-step='2']) .cp {
    --prog: 100%;
  }

  :global([data-step='0']) .chart.verify {
    opacity: 0.35;
  }

  :global([data-step='0']) .chart.verify .flow,
  :global([data-step='2']) .flow,
  :global([data-step='2']) .progress i::after {
    animation-play-state: paused;
  }

  :global([data-step='2']) .toast {
    opacity: 1;
    translate: 0 0;
  }

  @keyframes cp-flow {
    to {
      transform: translateX(-320px);
    }
  }

  @keyframes cp-shine {
    60%,
    100% {
      translate: 100% 0;
    }
  }

  @keyframes cp-blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .progress i::after,
    .status.busy::before {
      animation: none;
    }
  }
</style>
