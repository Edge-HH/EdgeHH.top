---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <section class="page sheet nf">
    <p class="label mono">404</p>
    <div>
      <h1>这个页面不存在。</h1>
      <p class="muted">链接可能已经失效，或者地址输入有误。</p>
      <p class="links">
        <a class="link" href="/">回到首页</a>
        <a class="link" href="/posts/">看看文章</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: 72px;
  }

  h1 {
    font-size: 28px;
  }

  .muted {
    margin-top: 8px;
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }
</style>
