---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import ProjectMockup from '../components/ProjectMockup.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getProjects, projectStyle } from '../lib/content';
import { site } from '../site.config';

const projects = await getProjects();
const latest = (await getPosts()).slice(0, 3);

const manifesto = '每个项目都从一个具体的麻烦开始：课表要随时看得到，作业要一眼看得清，素材要一个字节都不差。';
// 按标点切成短语，短语尽量整体换行；每个字带全局序号，滚动时依次点亮
let charIndex = 0;
const phrases = (manifesto.match(/[^：，。]+[：，。]?/g) ?? []).map((phrase) =>
  [...phrase].map((ch) => ({ ch, i: charIndex++ }))
);
---

<BaseLayout>
  <!-- 首屏 -->
  <section class="hero" data-scrub="sticky">
    <div class="hero-pin">
      <div class="aurora" aria-hidden="true">
        <span class="blob b1"></span>
        <span class="blob b2"></span>
        <span class="blob b3"></span>
      </div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content container">
        <p class="eyebrow hero-in" style="--i:0">EdgeHH · 作品集</p>
        <h1 class="hero-title">
          <span class="hero-in" style="--i:1">把想法，</span>
          <span class="hero-in" style="--i:2">做成<span class="brand-gradient-text">趁手的工具</span>。</span>
        </h1>
        <p class="hero-sub hero-in" style="--i:3">为课堂、创作与日常而写的软件。</p>
        <ul class="hero-projects hero-in" style="--i:4">
          {
            projects.map((p) => (
              <li>
                <a href={`#p-${p.id}`} style={projectStyle(p)}>
                  <i />
                  {p.data.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="scroll-cue" aria-hidden="true">
        <span>向下滑动</span>
        <i></i>
      </div>
    </div>
  </section>

  <!-- 逐字点亮的引言 -->
  <section class="manifesto" data-scrub="sticky" aria-label="引言">
    <div class="manifesto-pin container">
      <p class="manifesto-text" style={`--n:${charIndex}`}>
        <span class="sr-only">{manifesto}</span>
        {phrases.map((phrase) => <span class="phrase" aria-hidden="true">{phrase.map(({ ch, i }) => <span style={`--i:${i}`}>{ch}</span>)}</span>)}
      </p>
      <p class="manifesto-coda">于是，有了下面这三个项目。</p>
    </div>
  </section>

  <!-- 项目章节：滚动时样机放大，并分段切换说明 -->
  <div id="projects">
    {
      projects.map((p, index) => (
        <section
          class="chapter"
          id={`p-${p.id}`}
          data-scrub="sticky"
          data-steps={p.data.steps.length || undefined}
          style={projectStyle(p)}
          aria-labelledby={`p-${p.id}-title`}
        >
          <div class="chapter-pin">
            <header class="chapter-head container">
              <p class="chapter-index">
                <span>{String(index + 1).padStart(2, '0')}</span>
                {p.data.platforms.slice(0, 3).join(' · ')}
              </p>
              <h2 class="chapter-title" id={`p-${p.id}-title`}>
                {p.data.name}
              </h2>
              <p class="chapter-tagline">{p.data.tagline}</p>
            </header>

            <div class="chapter-stage">
              <div class="chapter-glow" aria-hidden="true" />
              <div class="chapter-device">
                <ProjectMockup project={p} />
              </div>
            </div>

            <footer class="chapter-foot container">
              <div class="chapter-steps">
                {p.data.steps.length > 1 && (
                  <div class="dots" aria-hidden="true">
                    {p.data.steps.map(() => (
                      <i />
                    ))}
                  </div>
                )}
                <ol class="steps">
                  {p.data.steps.map((s) => (
                    <li>
                      <strong>{s.title}</strong>
                      <p>{s.desc}</p>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="chapter-ctas">
                <a class="btn btn-accent" href={`/projects/${p.id}/`}>
                  了解更多
                </a>
                <a class="link-arrow" href={p.data.repo} target="_blank" rel="noopener">
                  GitHub
                  <Icon name="chevron" />
                </a>
              </div>
            </footer>
          </div>
        </section>
      ))
    }
  </div>

  <!-- 项目一览 -->
  <section class="section lineup" id="lineup">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">选一个，深入了解。</h2>
      </div>
      <div class="lineup-grid">
        {
          projects.map((p, i) => (
            <div data-reveal style={`--d:${i * 90}`}>
              <article class="lineup-card" style={projectStyle(p)}>
                <ProjectIcon project={p} size={72} />
                <h3>
                  <a class="stretched" href={`/projects/${p.id}/`}>
                    {p.data.name}
                  </a>
                </h3>
                <p class="lineup-tagline">{p.data.tagline}</p>
                <dl>
                  <div>
                    <dt>平台</dt>
                    <dd>{p.data.platforms.join(' · ')}</dd>
                  </div>
                  <div>
                    <dt>技术</dt>
                    <dd>{p.data.stack.join(' · ')}</dd>
                  </div>
                  {p.data.version && (
                    <div>
                      <dt>版本</dt>
                      <dd>{p.data.version}</dd>
                    </div>
                  )}
                </dl>
                <div class="lineup-links">
                  <span class="link-arrow">
                    了解更多
                    <Icon name="chevron" />
                  </span>
                  <a class="link-arrow lifted" href={p.data.repo} target="_blank" rel="noopener">
                    GitHub
                    <Icon name="external" />
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  {
    latest.length > 0 && (
      <section class="section latest">
        <div class="container">
          <div class="section-head" data-reveal>
            <h2 class="section-title">最新文章</h2>
            <a class="link-arrow" href="/posts/">
              全部文章
              <Icon name="chevron" />
            </a>
          </div>
          <div class="latest-grid">
            {latest.map((post, i) => (
              <PostCard post={post} delay={i * 90} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 结尾 -->
  <section class="section outro">
    <div class="container outro-inner" data-reveal="blur">
      <h2 class="section-title">代码都在 GitHub 上。</h2>
      <p class="lead">欢迎 Star、提 Issue，或者在文章下面留言。</p>
      <div class="outro-ctas">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener">
          <Icon name="github" />
          访问 GitHub
        </a>
        <a class="btn btn-ghost" href="/rss.xml">
          <Icon name="rss" />
          订阅 RSS
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 首屏 ---------- */
  .hero {
    position: relative;
    height: 160svh;
    margin-top: calc(var(--nav-h) * -1);
  }

  .hero-pin {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: -10%;
    opacity: calc(var(--aurora-opacity) * (1 - var(--p, 0) * 0.6));
    scale: calc(1 + var(--p, 0) * 0.3);
  }

  .blob {
    position: absolute;
    width: 62vmax;
    height: 62vmax;
    border-radius: 50%;
    animation: drift 20s ease-in-out infinite alternate;
  }

  .b1 {
    top: -12%;
    left: -6%;
    background: radial-gradient(closest-side, rgb(10 132 255 / 0.55), transparent);
  }

  .b2 {
    top: 18%;
    right: -14%;
    background: radial-gradient(closest-side, rgb(255 159 10 / 0.45), transparent);
    animation-duration: 24s;
    animation-delay: -8s;
  }

  .b3 {
    bottom: -24%;
    left: 18%;
    background: radial-gradient(closest-side, rgb(19 194 163 / 0.5), transparent);
    animation-duration: 28s;
    animation-delay: -14s;
  }

  @keyframes drift {
    50% {
      translate: 6vmax -4vmax;
      scale: 1.08;
    }

    100% {
      translate: -5vmax 4vmax;
      scale: 0.94;
    }
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 55% 48% at 50% 48%, #000000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 55% 48% at 50% 48%, #000000 20%, transparent 75%);
  }

  .hero-content {
    position: relative;
    text-align: center;
    opacity: calc(1 - var(--p, 0) * 1.4);
    scale: calc(1 - var(--p, 0) * 0.12);
    translate: 0 calc(var(--p, 0) * -8vh);
  }

  .hero-title {
    margin: 18px 0 22px;
    font-size: clamp(44px, 8.6vw, 112px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .hero-title > span {
    display: block;
  }

  .hero-sub {
    color: var(--fg-2);
    font-size: clamp(19px, 2.2vw, 26px);
    font-weight: 500;
  }

  .hero-projects {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 36px;
    list-style: none;
  }

  .hero-projects a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: 15px;
    font-weight: 500;
    transition:
      border-color 0.3s,
      translate 0.4s var(--ease);
  }

  .hero-projects a:hover {
    border-color: var(--accent);
    translate: 0 -2px;
  }

  .hero-projects i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  /* 首屏文字载入动画 */
  .hero-in {
    animation: rise 1.2s var(--ease) both;
    animation-delay: calc(var(--i) * 110ms + 120ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.5em;
      filter: blur(10px);
    }
  }

  .scroll-cue {
    position: absolute;
    bottom: max(24px, env(safe-area-inset-bottom));
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    color: var(--fg-3);
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: calc(1 - var(--p, 0) * 4);
  }

  .scroll-cue i {
    position: relative;
    width: 1px;
    height: 40px;
    background: var(--line-2);
    overflow: hidden;
  }

  .scroll-cue i::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    height: 14px;
    background: var(--fg);
    animation: cue 2s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    from {
      translate: 0 -14px;
    }

    to {
      translate: 0 40px;
    }
  }

  /* ---------- 引言 ---------- */
  .manifesto {
    height: 220svh;
  }

  .manifesto-pin {
    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    gap: 32px;
    height: 100svh;
  }

  .manifesto-text {
    max-width: 18.5em;
    font-size: clamp(30px, 4.2vw, 60px);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .phrase {
    display: inline-block;
  }

  .phrase span {
    opacity: clamp(0.15, calc((var(--p, 1) * 1.3 * var(--n) - var(--i)) / 4), 1);
  }

  .manifesto-coda {
    color: var(--fg-2);
    font-size: clamp(19px, 2.2vw, 26px);
    font-weight: 500;
    opacity: clamp(0, calc((var(--p, 1) - 0.8) * 6), 1);
  }

  /* ---------- 项目章节 ---------- */
  .chapter {
    position: relative;
    height: 300svh;
  }

  .chapter-pin {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(12px, 2.6vh, 28px);
    height: 100svh;
    padding: calc(var(--nav-h) + clamp(12px, 3vh, 32px)) 0 clamp(16px, 3.5vh, 36px);
    overflow: hidden;
  }

  .chapter-head {
    text-align: center;
  }

  /* 宽屏时标题与标语并排，给样机留出更多高度 */
  @media (min-width: 900px) {
    .chapter-head {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: 40px;
      text-align: left;
    }

    .chapter-index {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .chapter-tagline {
      justify-self: end;
      margin: 0 0 0.35em;
      text-align: right;
    }
  }

  .chapter-index {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-2);
    font-size: 13px;
    font-weight: 500;
  }

  .chapter-index span {
    padding: 2px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .chapter-title {
    margin-top: 8px;
    font-size: clamp(40px, 6.4vw, 80px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .chapter-tagline {
    margin-top: 8px;
    font-size: clamp(19px, 2.4vw, 30px);
    font-weight: 600;
    color: var(--fg-2);
  }

  .chapter-stage {
    --intro: min(1, calc(var(--p, 1) * 5));
    position: relative;
    display: grid;
    place-items: center;
    container-type: size;
    padding-inline: var(--gutter);
  }

  .chapter-device {
    position: relative;
    width: min(100cqw, 1000px, 156.25cqh);
    scale: calc(0.84 + 0.16 * var(--intro));
    translate: 0 calc((1 - var(--intro)) * 6vh);
    opacity: calc(0.25 + 0.75 * var(--intro));
  }

  .chapter-glow {
    position: absolute;
    width: min(100cqw, 1100px);
    height: 100cqh;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent);
    opacity: calc(var(--intro) * 0.9);
    pointer-events: none;
  }

  .chapter-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 16px 40px;
  }

  .dots {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
  }

  .dots i {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--line-2);
    transition:
      width 0.5s var(--ease),
      background-color 0.5s;
  }

  .steps {
    display: grid;
    list-style: none;
  }

  .steps li {
    grid-area: 1 / 1;
    max-width: 40em;
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 0.5s var(--ease),
      translate 0.7s var(--ease);
  }

  .steps strong {
    display: block;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
  }

  .steps p {
    margin-top: 4px;
    color: var(--fg-2);
    font-size: clamp(15px, 1.25vw, 17px);
  }

  .chapter:not([data-step]) .steps li:first-child,
  .chapter[data-step='0'] .steps li:nth-child(1),
  .chapter[data-step='1'] .steps li:nth-child(2),
  .chapter[data-step='2'] .steps li:nth-child(3),
  .chapter[data-step='3'] .steps li:nth-child(4),
  .chapter[data-step='4'] .steps li:nth-child(5) {
    opacity: 1;
    translate: 0 0;
  }

  .chapter:not([data-step]) .dots i:first-child,
  .chapter[data-step='0'] .dots i:nth-child(1),
  .chapter[data-step='1'] .dots i:nth-child(2),
  .chapter[data-step='2'] .dots i:nth-child(3),
  .chapter[data-step='3'] .dots i:nth-child(4),
  .chapter[data-step='4'] .dots i:nth-child(5) {
    width: 24px;
    background: var(--accent);
  }

  .chapter-ctas {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  @media (max-width: 734px) {
    .chapter-foot {
      grid-template-columns: 1fr;
    }

    .chapter-ctas .btn {
      min-height: 40px;
      padding: 8px 18px;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .scroll-cue i::after,
    .hero-in {
      animation: none;
    }

    .hero-content,
    .aurora,
    .chapter-device {
      scale: 1;
      translate: 0 0;
    }
  }

  /* ---------- 项目一览 ---------- */
  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .lineup-grid > div {
    display: flex;
  }

  .lineup-card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 28px 28px;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      translate 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      border-color 0.3s;
  }

  .lineup-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 45% at 50% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent);
    pointer-events: none;
  }

  .lineup-card:hover {
    translate: 0 -6px;
    box-shadow: var(--shadow-2);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .lineup-card h3 {
    margin-top: 10px;
    font-size: 30px;
    font-weight: 700;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .lineup-tagline {
    color: var(--fg-2);
    font-size: 17px;
  }

  .lineup-card dl {
    display: grid;
    gap: 10px;
    margin: 6px 0 4px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }

  .lineup-card dl div {
    display: grid;
    grid-template-columns: 3em 1fr;
    gap: 12px;
  }

  .lineup-card dt {
    color: var(--fg-3);
  }

  .lineup-card dd {
    margin: 0;
  }

  .lineup-links {
    display: flex;
    gap: 24px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
  }

  .lifted {
    position: relative;
    z-index: 1;
  }

  /* ---------- 最新文章 ---------- */
  .latest {
    padding-top: 0;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  /* ---------- 结尾 ---------- */
  .outro {
    padding-top: 0;
  }

  .outro-inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: clamp(56px, 9vw, 112px) var(--gutter);
    border-radius: var(--r-xl);
    background:
      radial-gradient(60% 80% at 15% 0%, rgb(10 132 255 / 0.12), transparent 70%),
      radial-gradient(60% 80% at 85% 100%, rgb(19 194 163 / 0.12), transparent 70%),
      var(--surface);
    border: 1px solid var(--line);
    text-align: center;
  }

  .outro-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 10px;
  }
</style>
