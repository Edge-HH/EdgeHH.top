---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import Shot from '../components/Shot.astro';
import Lightbox from '../components/Lightbox.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getProjects, isoDate } from '../lib/content';

const projects = await getProjects();
const latest = (await getPosts()).slice(0, 5);
---

<BaseLayout>
  <div class="page">
    <section class="intro sheet">
      <p class="label"><b>EdgeHH</b>Edge-HH</p>
      <div>
        <h1>我写的几个开源软件，和它们的更新记录。</h1>
        <p class="lede">
          RemoteCI 和 Pancake 用在教室里：一个把 ClassIsland 课表和课堂控制接到网页、手机和手表上，一个是教室大屏上的作业看板；ClipPort
          用来拷贝和校验拍摄素材。每个项目页都有完整的功能说明、最新版本的截图和下载地址。
        </p>
      </div>
    </section>

    <section class="projects sheet rule-top" aria-labelledby="projects-title">
      <p class="label" id="projects-title"><b>项目</b>{projects.length} 个</p>
      <div>
        {
          projects.map((p, i) => {
            const d = p.data;
            const cover = d.screenshots.find((s) => s.cover) ?? d.screenshots[0];
            return (
              <article class="entry">
                <div class="text">
                  <div class="head">
                    <ProjectIcon project={p} size={40} />
                    <h2>
                      <a href={`/projects/${p.id}/`}>{d.name}</a>
                    </h2>
                  </div>
                  <p class="version mono">
                    {d.version} · {isoDate(d.released)}
                    {d.prerelease && <span class="tag warn">预发布</span>}
                  </p>
                  <p class="summary">{d.summary}</p>
                  <dl class="facts">
                    <div>
                      <dt>平台</dt>
                      <dd>{d.platforms.join('、')}</dd>
                    </div>
                    <div>
                      <dt>技术</dt>
                      <dd>{d.stack.join('、')}</dd>
                    </div>
                  </dl>
                  <p class="links">
                    <a class="link strong" href={`/projects/${p.id}/`}>
                      完整介绍
                    </a>
                    <a class="link" href={d.download} target="_blank" rel="noopener">
                      下载
                    </a>
                    <a class="link" href={d.repo} target="_blank" rel="noopener">
                      源代码
                    </a>
                  </p>
                </div>
                {cover && (
                  <Shot
                    src={cover.src}
                    dark={cover.dark}
                    alt={cover.alt}
                    caption={cover.caption}
                    build={cover.build}
                    kind={cover.kind}
                    sizes="(min-width: 1160px) 620px, (min-width: 900px) 55vw, 100vw"
                    eager={i === 0}
                  />
                )}
              </article>
            );
          })
        }
      </div>
    </section>

    {
      latest.length > 0 && (
        <section class="posts sheet rule-top" aria-labelledby="posts-title">
          <p class="label" id="posts-title">
            <b>文章</b>更新日志与笔记
          </p>
          <div>
            <PostList posts={latest} />
            <p class="all">
              <a class="link" href="/posts/">
                全部文章
              </a>
            </p>
          </div>
        </section>
      )
    }
  </div>
  <Lightbox />
</BaseLayout>

<style>
  .intro {
    padding-block: 56px 48px;
  }

  h1 {
    max-width: 22em;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.4;
  }

  .lede {
    max-width: 40em;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 16.5px;
  }

  .projects,
  .posts {
    padding-top: 32px;
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: 24px 40px;
    padding-bottom: 40px;
  }

  .entry + .entry {
    padding-top: 40px;
    border-top: 1px solid var(--rule-soft);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h2 {
    font-size: 26px;
    line-height: 1.2;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--signal);
  }

  .version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: var(--ink-3);
  }

  .summary {
    margin-top: 10px;
  }

  .facts {
    display: grid;
    gap: 4px;
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.6;
  }

  .facts div {
    display: grid;
    grid-template-columns: 3em minmax(0, 1fr);
    gap: 8px;
  }

  .facts dt {
    color: var(--ink-3);
  }

  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 18px;
    font-size: 15px;
  }

  .links .strong {
    font-weight: 600;
  }

  .links .strong::after {
    content: ' →';
  }

  .posts {
    margin-top: 16px;
  }

  .posts :global(.post-list) {
    border-top: 0;
  }

  .posts :global(.post-list li:first-child) {
    padding-top: 0;
  }

  .all {
    margin-top: 16px;
    font-size: 15px;
  }

  @media (max-width: 1100px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 窄屏时页眉已经显示站点名 */
  @media (max-width: 900px) {
    .intro .label {
      display: none;
    }

    .intro {
      padding-block: 32px;
    }
  }
</style>
