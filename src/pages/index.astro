---
const title = 'EdgeHH.top';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="EdgeHH.top 作品展示站" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">EDGEHH.TOP</p>
      <h1>作品展示站</h1>
      <p class="intro">网站空壳已部署准备完成，内容正在整理中。</p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    color: #171717;
    background: #f5f5f0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  main { width: min(680px, calc(100% - 48px)); }
  .eyebrow { margin: 0 0 20px; color: #737373; font-size: 12px; letter-spacing: .18em; }
  h1 { margin: 0; font-size: clamp(42px, 8vw, 84px); line-height: .98; letter-spacing: -.06em; }
  .intro { margin-top: 28px; color: #666; font-size: 18px; line-height: 1.6; }
</style>
