---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { formatDate, getPosts, isoDate, readingMinutes, type Post } from '../../lib/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] }
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, comments } = post.data;
const { Content, headings } = await render(post);
const project = post.data.project ? await getEntry(post.data.project) : undefined;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} type="article">
  <article class="page">
    <header class="sheet head">
      <p class="label">
        <a class="link" href="/posts/">全部文章</a>
      </p>
      <div>
        <p class="meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span>约 {readingMinutes(post.body)} 分钟</span>
          {tags.map((tag) => <a class="tag" href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
        </p>
        <h1>{title}</h1>
        {description && <p class="lede">{description}</p>}
        {
          project && (
            <a class="project" href={`/projects/${project.id}/`}>
              <ProjectIcon project={project} size={24} />
              <span>
                相关项目：<b>{project.data.name}</b>
              </span>
            </a>
          )
        }
      </div>
    </header>

    <div class="sheet body rule-top">
      <nav class="toc label" aria-label="本文目录">
        {
          toc.length >= 3 && (
            <>
              <b>目录</b>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </>
          )
        }
      </nav>
      <div>
        <div class="prose">
          <Content />
        </div>

        <footer class="foot">
          {updated && <p class="updated">最后更新于 {formatDate(updated)}</p>}
          {
            (newer || older) && (
              <nav class="pager" aria-label="相邻文章">
                {older ? (
                  <a href={`/posts/${older.id}/`}>
                    <small>上一篇</small>
                    {older.data.title}
                  </a>
                ) : (
                  <span />
                )}
                {newer && (
                  <a class="next" href={`/posts/${newer.id}/`}>
                    <small>下一篇</small>
                    {newer.data.title}
                  </a>
                )}
              </nav>
            )
          }
          {comments && <Comments />}
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: 48px 32px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    color: var(--ink-3);
    font-size: 14px;
  }

  .meta .tag {
    text-decoration: none;
  }

  h1 {
    max-width: 22em;
    margin-top: 12px;
    font-size: clamp(26px, 3.6vw, 36px);
    line-height: 1.35;
  }

  .lede {
    max-width: 40em;
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 17px;
  }

  .project {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }

  .project:hover b {
    color: var(--signal);
  }

  .project b {
    color: var(--ink);
  }

  .body {
    padding-top: 32px;
  }

  .toc {
    position: sticky;
    top: 24px;
    align-self: start;
  }

  .toc ol {
    margin-top: 8px;
    padding-left: 1.2em;
  }

  .toc li + li {
    margin-top: 4px;
  }

  .toc a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--signal);
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }

  .foot {
    max-width: 44em;
    margin-top: 56px;
  }

  .updated {
    color: var(--ink-3);
    font-size: 14px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 2px;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }

  .pager a:hover {
    color: var(--signal);
  }

  .pager small {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 400;
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
