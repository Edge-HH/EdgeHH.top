---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<BaseLayout title="文章" description="EdgeHH 的更新日志与开发笔记。">
  <div class="page">
    <section class="sheet head">
      <p class="label"><b>文章</b>{posts.length} 篇</p>
      <div>
        <h1>更新日志与开发笔记</h1>
        <p class="lede">
          项目发布新版本时的说明，以及开发过程中的记录。也可以用 <a class="link" href="/rss.xml">RSS</a> 订阅。
        </p>
        {
          tags.length > 1 && (
            <div class="filters" role="group" aria-label="按标签筛选">
              <button type="button" aria-pressed="true" data-tag="">
                全部
              </button>
              {tags.map((tag) => (
                <button type="button" aria-pressed="false" data-tag={tag}>
                  {tag}
                </button>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="sheet">
      <span></span>
      <div>
        {posts.length === 0 ? <p class="muted">还没有文章。</p> : <PostList posts={posts} />}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag]');

  const apply = (tag: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    document.querySelectorAll<HTMLElement>('[data-tags]').forEach((row) => {
      row.hidden = Boolean(tag) && !(row.dataset.tags ?? '').split('|').includes(tag);
    });
    const url = new URL(location.href);
    if (tag) url.searchParams.set('tag', tag);
    else url.searchParams.delete('tag');
    history.replaceState(null, '', url);
  };

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.tag ?? '')));

  const initial = new URL(location.href).searchParams.get('tag');
  if (initial && [...buttons].some((b) => b.dataset.tag === initial)) apply(initial);
</script>

<style>
  .head {
    padding-block: 48px 32px;
  }

  h1 {
    font-size: clamp(26px, 3.4vw, 34px);
  }

  .lede {
    margin-top: 12px;
    color: var(--ink-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .filters button {
    padding: 2px 10px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: transparent;
    color: var(--ink-2);
    font-size: 13.5px;
    cursor: pointer;
  }

  .filters button:hover {
    border-color: var(--ink-2);
  }

  .filters button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }
</style>
