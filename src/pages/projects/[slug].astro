---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import Shot from '../../components/Shot.astro';
import Lightbox from '../../components/Lightbox.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getProjects, isoDate, type Project } from '../../lib/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const posts = (await getPosts()).filter((post) => post.data.project?.id === project.id);
const releasesUrl = `${d.repo}/releases`;

const wide = d.screenshots.filter((s) => s.kind === 'wide');
const small = d.screenshots.filter((s) => s.kind !== 'wide');
const numbered = [...wide, ...small].map((s, i) => ({ ...s, number: i + 1 }));
const [lead, ...restWide] = numbered.slice(0, wide.length);
const smallShots = numbered.slice(wide.length);

// 目录顺序与正文里 h2 的出现顺序一致，编号由 CSS 计数器生成
const sections = [
  ...(d.screenshots.length ? [{ id: 'screenshots', text: '截图' }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(d.releases.length ? [{ id: 'releases', text: '版本记录' }] : []),
  ...(posts.length ? [{ id: 'posts', text: '相关文章' }] : [])
];
const two = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={d.name} description={`${d.name}：${d.summary}`}>
  <div class="page">
    <header class="top sheet">
      <div class="label icon-col">
        <ProjectIcon project={project} size={56} />
      </div>
      <div>
        <h1>{d.name}</h1>
        <p class="intro">{d.intro}</p>

        <dl class="meta">
          <div>
            <dt>最新版本</dt>
            <dd>
              <a class="link mono" href={releasesUrl} target="_blank" rel="noopener">{d.version}</a>
              {d.prerelease && <span class="tag warn">预发布</span>}
            </dd>
          </div>
          <div>
            <dt>发布日期</dt>
            <dd class="mono">{isoDate(d.released)}</dd>
          </div>
          <div class="span">
            <dt>平台</dt>
            <dd>{d.platforms.join('、')}</dd>
          </div>
          <div class="span">
            <dt>技术</dt>
            <dd>{d.stack.join('、')}</dd>
          </div>
          <div>
            <dt>许可证</dt>
            <dd>{d.license}</dd>
          </div>
          <div class="span">
            <dt>源代码</dt>
            <dd>
              <a class="link" href={d.repo} target="_blank" rel="noopener">{d.repo.replace('https://', '')}</a>
            </dd>
          </div>
        </dl>

        <p class="actions">
          <a class="button primary" href={d.download} target="_blank" rel="noopener">
            下载 <small>{d.version}</small>
          </a>
          {
            d.docs && (
              <a class="button" href={d.docs} target="_blank" rel="noopener">
                使用文档
              </a>
            )
          }
          <a class="button" href={d.repo} target="_blank" rel="noopener">GitHub</a>
        </p>

        {d.notice && <p class="notice">{d.notice}</p>}
      </div>
    </header>

    <div class="body sheet rule-top">
      <nav class="toc" aria-label="本页目录">
        <p class="label"><b>目录</b></p>
        <ol>
          {
            sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="mono">{two(i + 1)}</span>
                  {s.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="content">
        {
          lead && (
            <section class="gallery" aria-labelledby="screenshots">
              <h2 id="screenshots">截图</h2>
              <p class="gallery-note">点击图片查看原尺寸。网站切到深色时，有深色版本的截图会一起切换。</p>
              <Shot {...lead} sizes="(min-width: 1160px) 960px, 100vw" eager />
              {restWide.length > 0 && (
                <div class="grid-2">
                  {restWide.map((s) => (
                    <Shot {...s} sizes="(min-width: 1160px) 470px, (min-width: 700px) 48vw, 100vw" />
                  ))}
                </div>
              )}
              {smallShots.length > 0 && (
                <div class="grid-4">
                  {smallShots.map((s) => (
                    <Shot {...s} sizes="(min-width: 1160px) 230px, (min-width: 700px) 24vw, 50vw" />
                  ))}
                </div>
              )}
            </section>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          d.releases.length > 0 && (
            <section aria-labelledby="releases">
              <h2 id="releases">版本记录</h2>
              <ol class="releases">
                {d.releases.map((r) => (
                  <li>
                    <p class="rel-head">
                      <a class="link mono" href={`${d.repo}/releases/tag/${r.version}`} target="_blank" rel="noopener">
                        {r.version}
                      </a>
                      <time class="mono" datetime={isoDate(r.date)}>
                        {isoDate(r.date)}
                      </time>
                      {r.prerelease && <span class="tag">预发布</span>}
                    </p>
                    {r.notes.length > 0 && (
                      <ul>
                        {r.notes.map((n) => (
                          <li>{n}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
              <p class="more">
                <a class="link" href={releasesUrl} target="_blank" rel="noopener">
                  GitHub Releases 上的全部版本
                </a>
              </p>
            </section>
          )
        }

        {
          posts.length > 0 && (
            <section aria-labelledby="posts">
              <h2 id="posts">相关文章</h2>
              <PostList posts={posts} showProject={false} />
            </section>
          )
        }
      </div>
    </div>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  .top {
    padding-block: 48px 40px;
  }

  .icon-col {
    padding-top: 6px;
  }

  h1 {
    font-size: clamp(32px, 4.4vw, 44px);
    line-height: 1.15;
  }

  .intro {
    max-width: 40em;
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 17px;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px 32px;
    max-width: 760px;
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule-soft);
    font-size: 14px;
    line-height: 1.6;
  }

  .meta dt {
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .meta dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 2px 0 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .notice {
    max-width: 44em;
    margin-top: 24px;
    padding: 12px 14px;
    border-left: 2px solid var(--signal);
    background: var(--bg-sunk);
    color: var(--ink-2);
    font-size: 14.5px;
  }

  /* ---------- 目录 ---------- */
  .body {
    padding-top: 40px;
  }

  .toc {
    position: sticky;
    top: 24px;
    align-self: start;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .toc ol {
    margin-top: 10px;
    list-style: none;
  }

  .toc li + li {
    margin-top: 6px;
  }

  .toc a {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    color: var(--ink-2);
    text-decoration: none;
  }

  .toc a:hover,
  .toc a[aria-current='true'] {
    color: var(--signal);
  }

  .toc .mono {
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }

    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- 正文与章节编号 ---------- */
  .content {
    counter-reset: sec;
    min-width: 0;
  }

  .content :global(h2) {
    counter-increment: sec;
    margin-top: 72px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 22px;
    line-height: 1.4;
    scroll-margin-top: 16px;
  }

  .content :global(h2::before) {
    content: counter(sec, decimal-leading-zero);
    display: block;
    margin-bottom: 4px;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 400;
  }

  /* 第一个章节紧接着上方的分隔线，不再重复画线 */
  .content > :first-child > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  /* 分隔线贯穿整栏，正文段落保持易读宽度 */
  .content .prose {
    max-width: none;
  }

  .content .prose > :global(:not(h2)) {
    max-width: 44em;
  }

  .gallery-note {
    margin: 6px 0 20px;
    color: var(--ink-3);
    font-size: 13.5px;
  }

  .grid-2,
  .grid-4 {
    display: grid;
    gap: 28px 24px;
    margin-top: 32px;
  }

  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
  }

  @media (max-width: 700px) {
    .grid-2 {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta .span {
      grid-column: 1 / -1;
    }
  }

  /* ---------- 版本记录 ---------- */
  .releases {
    max-width: 44em;
    margin-top: 16px;
    list-style: none;
  }

  .releases > li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .rel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .rel-head .link {
    font-weight: 600;
  }

  .rel-head time {
    color: var(--ink-3);
  }

  .releases ul {
    margin-top: 6px;
    list-style: none;
    color: var(--ink-2);
    font-size: 14.5px;
  }

  .releases ul li {
    position: relative;
    padding-left: 1.2em;
  }

  .releases ul li::before {
    content: '';
    position: absolute;
    top: 0.9em;
    left: 0.1em;
    width: 0.55em;
    height: 1px;
    background: var(--ink-3);
  }

  .more {
    margin-top: 14px;
    font-size: 14.5px;
  }
</style>

<script>
  // 目录高亮当前阅读的章节
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    const update = () => {
      const line = window.innerHeight * 0.25;
      let current = 0;
      targets.forEach((el, i) => {
        if (el.getBoundingClientRect().top < line) current = i;
      });
      links.forEach((a, i) => a.setAttribute('aria-current', String(i === current)));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
